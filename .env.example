# Application Configuration
PROJECT_NAME="Healthcare Management API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Security & JWT
SECRET_KEY="super-secret-key-change-this-in-production-use-a-strong-random-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database Configuration
# Default: SQLite (health_app.db in root directory)
# For PostgreSQL: postgresql://user:password@localhost:5432/health_db
DATABASE_URL="sqlite:///./health_app.db"

# Rate Limiting
RATE_LIMIT_DEFAULT="100/minute"
RATE_LIMIT_AUTH="20/minute"

# CORS
BACKEND_CORS_ORIGINS=["*"]
